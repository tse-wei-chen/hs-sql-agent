<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>portable</DebugType>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
		<PackageReference Include="dapper" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../HsSqlAgent.SqlCore/HsSqlAgent.SqlCore.csproj" />
		<ProjectReference Include="../HsSqlAgent.Provider.Abstractions/HsSqlAgent.Provider.Abstractions.csproj" />
		<ProjectReference Include="../HsSqlAgent.Provider.PostgreSql/HsSqlAgent.Provider.PostgreSql.csproj" />
		<ProjectReference Include="../HsSqlAgent.Provider.MySql/HsSqlAgent.Provider.MySql.csproj" />
		<ProjectReference Include="../HsSqlAgent.Provider.Sqlite/HsSqlAgent.Provider.Sqlite.csproj" />
		<ProjectReference Include="../HsSqlAgent.Provider.SqlServer/HsSqlAgent.Provider.SqlServer.csproj" />
		<ProjectReference Include="../HsSqlAgent.Provider.Oracle/HsSqlAgent.Provider.Oracle.csproj" />
		<ProjectReference Include="../HsSqlAgent.Provider.Firebird/HsSqlAgent.Provider.Firebird.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SqlAgent.Test" />
	</ItemGroup>

	<!-- SQL compiler and provider runtime contracts/implementations now have separate assembly owners.
	     Keep source paths stable during the extraction so namespace/path churn is not mixed with package boundaries. -->
	<ItemGroup>
		<Compile Remove="Core/Analysis/**/*.cs" />
		<Compile Remove="Core/Ast/**/*.cs" />
		<Compile Remove="Core/Binding/**/*.cs" />
		<Compile Remove="Core/Compilation/**/*.cs" />
		<Compile Remove="Core/Lowering/**/*.cs" />
		<Compile Remove="Core/Mapping/**/*.cs" />
		<Compile Remove="Core/Normalization/**/*.cs" />
		<Compile Remove="Core/Pipeline/**/*.cs" />
		<Compile Remove="Core/Execution/DmlFingerprintService.cs" />
		<Compile Remove="Core/Execution/IDbConnectionFactory.cs" />
		<Compile Remove="Core/Execution/DmlPreviewTransactionFactory.cs" />
		<Compile Remove="Core/Providers/**/*.cs" />
		<Compile Remove="Enums/**/*.cs" />
		<Compile Remove="Models/**/*.cs" />
		<Compile Remove="SqlParsing/**/*.cs" />
		<Compile Remove="SqlTranslation/**/*.cs" />
		<EmbeddedResource Remove="SqlTranslation/Functions/Definitions/*.json" />
	</ItemGroup>

</Project>
