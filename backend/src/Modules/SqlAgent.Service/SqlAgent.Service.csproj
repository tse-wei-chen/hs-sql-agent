<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>portable</DebugType>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
		<PackageReference Include="dapper" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="MySql.Data" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Oracle.ManagedDataAccess.Core" />
		<PackageReference Include="FirebirdSql.Data.FirebirdClient" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../HsSqlAgent.SqlCore/HsSqlAgent.SqlCore.csproj" />
	</ItemGroup>

	<!-- SQL compiler source is owned by HsSqlAgent.SqlCore. Keep the source files in their existing
	     paths during the assembly extraction so namespace/path churn is not mixed with the package
	     boundary change. SqlAgent.Service compiles only runtime/provider/application code. -->
	<ItemGroup>
		<Compile Remove="Core/Analysis/**/*.cs" />
		<Compile Remove="Core/Ast/**/*.cs" />
		<Compile Remove="Core/Binding/**/*.cs" />
		<Compile Remove="Core/Compilation/**/*.cs" />
		<Compile Remove="Core/Lowering/**/*.cs" />
		<Compile Remove="Core/Mapping/**/*.cs" />
		<Compile Remove="Core/Normalization/**/*.cs" />
		<Compile Remove="Core/Pipeline/**/*.cs" />
		<Compile Remove="Core/Execution/DmlFingerprintService.cs" />
		<Compile Remove="Enums/**/*.cs" />
		<Compile Remove="Models/**/*.cs" />
		<Compile Remove="SqlParsing/**/*.cs" />
		<Compile Remove="SqlTranslation/**/*.cs" />
		<EmbeddedResource Remove="SqlTranslation/Functions/Definitions/*.json" />
	</ItemGroup>

</Project>
