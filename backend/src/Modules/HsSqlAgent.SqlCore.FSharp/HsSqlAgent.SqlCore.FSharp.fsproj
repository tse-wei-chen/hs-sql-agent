<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>HsSqlAgent.SqlCore.FSharp</AssemblyName>
    <RootNamespace>HsSqlAgent.SqlCore</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FunctionalAst.fs" />
    <Compile Include="FunctionalTokenReader.fs" />
    <Compile Include="FunctionalDmlConflictParser.fs" />
    <Compile Include="FunctionalCommaFromNormalizer.fs" />
    <Compile Include="FunctionalExpressionTextParser.fs" />
    <Compile Include="FunctionalQueryTextParser.fs" />
    <Compile Include="FunctionalDmlTextParser.fs" />
    <Compile Include="FunctionalSqlTextParser.fs" />
    <Compile Include="FunctionalQueryBinder.fs" />
    <Compile Include="FunctionalDmlBinder.fs" />
    <Compile Include="FunctionalProviderFunctionNormalizer.fs" />
    <Compile Include="FunctionalQueryNormalizer.fs" />
    <Compile Include="FunctionalDmlNormalizer.fs" />
    <Compile Include="FunctionalAstRewriter.fs" />
    <Compile Include="FunctionalSourceProfileRewriter.fs" />
    <Compile Include="FunctionalProviderProfileRewriter.fs" />
    <Compile Include="FunctionalNullOrderingRewriter.fs" />
    <Compile Include="FunctionalNoFromReferenceValidator.fs" />
    <Compile Include="FunctionalCteColumnAliasRewriter.fs" />
    <Compile Include="FunctionalSqlPlanValidator.fs" />
    <Compile Include="FunctionalDmlPlanValidator.fs" />
    <Compile Include="FunctionalExecutionPolicyRewriter.fs" />
    <Compile Include="FunctionalRootCteSetTailRewriter.fs" />
    <Compile Include="FunctionalJoinProfileValidator.fs" />
    <Compile Include="FunctionalAggregateLocalOrderingGuard.fs" />
    <Compile Include="FunctionalAggregateFilterProfileValidator.fs" />
    <Compile Include="FunctionalSourceDialectValidator.fs" />
    <Compile Include="FunctionalDmlReturningExpressionCapabilityRules.fs" />
    <Compile Include="FunctionalNativeSetTailScope.fs" />
    <Compile Include="FunctionalNativeBackendCompatibility.fs" />
    <Compile Include="FunctionalPipeline.fs" />
    <Compile Include="Facade.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HsSqlAgent.SqlCore/HsSqlAgent.SqlCore.csproj" />
  </ItemGroup>

</Project>
