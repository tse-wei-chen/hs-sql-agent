<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>portable</DebugType>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>HsSqlAgent.Server</PackageId>
		<Authors>tse-wei-chen</Authors>
		<Company>hs-sql-agent</Company>
		<Description>Embeddable MCP SQL Agent server for ASP.NET Core. Add HsSqlAgent to any existing ASP.NET Core app with AddHsSqlAgent() / UseHsSqlAgent().</Description>
		<PackageTags>sql;mcp;ai;database;aspnetcore;hangfire-style</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/tse-wei-chen/hs-sql-agent</PackageProjectUrl>
		<RepositoryUrl>https://github.com/tse-wei-chen/hs-sql-agent.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
		<PackageReference Include="FSharp.Core" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" />
		<PackageReference Include="ModelContextProtocol" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
		<PackageReference Include="FluentValidation.AspNetCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
		<PackageReference Include="OpenTelemetry.Exporter.Prometheus.HttpListener" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
		<PackageReference Include="BCrypt.Net-Next" />
		<PackageReference Include="dapper" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
		<PackageReference Include="MySql.Data" />
		<PackageReference Include="Npgsql" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Oracle.ManagedDataAccess.Core" />
		<PackageReference Include="FirebirdSql.Data.FirebirdClient" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
		<PackageReference Include="StackExchange.Redis" />
		<PackageReference Include="Humanizer.Core" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Common\Common.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\..\Infrastructure\Infrastructure.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\Admin.Service\Admin.Service.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\Auth.Service\Auth.Service.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\HsSqlAgent.PostgresMigrations\HsSqlAgent.PostgresMigrations.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\HsSqlAgent.SqliteMigrations\HsSqlAgent.SqliteMigrations.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\HsSqlAgent.SqlCore\HsSqlAgent.SqlCore.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\HsSqlAgent.SqlCore.FSharp\HsSqlAgent.SqlCore.FSharp.fsproj" />
		<ProjectReference Include="..\HsSqlAgent.Provider.Abstractions\HsSqlAgent.Provider.Abstractions.csproj" />
		<ProjectReference Include="..\HsSqlAgent.Provider.PostgreSql\HsSqlAgent.Provider.PostgreSql.csproj" />
		<ProjectReference Include="..\HsSqlAgent.Provider.MySql\HsSqlAgent.Provider.MySql.csproj" />
		<ProjectReference Include="..\HsSqlAgent.Provider.Sqlite\HsSqlAgent.Provider.Sqlite.csproj" />
		<ProjectReference Include="..\HsSqlAgent.Provider.SqlServer\HsSqlAgent.Provider.SqlServer.csproj" />
		<ProjectReference Include="..\HsSqlAgent.Provider.Oracle\HsSqlAgent.Provider.Oracle.csproj" />
		<ProjectReference Include="..\HsSqlAgent.Provider.Firebird\HsSqlAgent.Provider.Firebird.csproj" />
		<ProjectReference Include="..\SqlAgent.Service\SqlAgent.Service.csproj" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="HsSqlAgent.Server.Test" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\..\..\miscellaneous\dml-approval-prompt.png" Pack="true" PackagePath="miscellaneous/" Visible="false" />
	</ItemGroup>

	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
				Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'
					And '%(ReferenceCopyLocalPaths.Filename)' != 'HsSqlAgent.SqlCore'
					And '%(ReferenceCopyLocalPaths.Filename)' != 'HsSqlAgent.SqlCore.Contracts'
					And '%(ReferenceCopyLocalPaths.Filename)' != 'HsSqlAgent.Provider.Abstractions'
					And ! $([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('HsSqlAgent.Provider.'))" />
		</ItemGroup>
	</Target>

	<Target Name="CompileFrontend" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
		<Message Importance="high" Text="[HsSqlAgent] Checking frontend dist status..." />
		<PropertyGroup>
			<_FrontendExists Condition="Exists('wwwroot\index.html')">true</_FrontendExists>
		</PropertyGroup>
		<Exec Command="pnpm install" WorkingDirectory="../../../../frontend" Condition="'$(_FrontendExists)' != 'true'" />
		<Exec Command="pnpm generate" WorkingDirectory="../../../../frontend" EnvironmentVariables="NODE_ENV=production" Condition="'$(_FrontendExists)' != 'true'" />
		<ItemGroup Condition="'$(_FrontendExists)' != 'true'">
			<FrontendDistFiles Include="../../../../frontend/dist\**\*.*" />
		</ItemGroup>
		<MakeDir Directories="wwwroot" Condition="'$(_FrontendExists)' != 'true'" />
		<Copy SourceFiles="@(FrontendDistFiles)" DestinationFiles="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="true" Condition="'$(_FrontendExists)' != 'true'" />
		<ItemGroup>
			<EmbeddedResource Include="wwwroot\**" />
		</ItemGroup>
	</Target>
</Project>
