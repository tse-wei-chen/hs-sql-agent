<Project>
  <PropertyGroup>
    <!-- One release version for every first-party NuGet package. Override with
         -p:VersionPrefix=... when preparing a release. -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">3.1.0</VersionPrefix>
    <!-- Immutable release policy and compatibility baselines; do not advance with VersionPrefix. -->
    <SecurityGateVersion>3.1.0</SecurityGateVersion>
    <PackageApiBaselineVersion>3.0.0</PackageApiBaselineVersion>
    <AdminMigrationBaselineVersion>2.0.6</AdminMigrationBaselineVersion>
    <Exclude>[*]*.Models.*</Exclude>
  </PropertyGroup>
</Project>
