	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch hs-sql-agent MCP ToolBox",
			"type": "coreclr",
			"request": "launch",
			"program": "${workspaceFolder}/backend/src/ToolBox/bin/Debug/net10.0/ToolBox.dll",
			"cwd": "${workspaceFolder}/backend/src/ToolBox/bin/Debug/net10.0",
			"stopAtEntry": false,
			"console": "internalConsole",
			"internalConsoleOptions": "openOnSessionStart",
			"preLaunchTask": "build"
		}
	]
}
